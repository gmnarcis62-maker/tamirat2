<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- 1. سایه بیرونی زیر Knob -->
    <path
        android:pathData="M100,0 a100,100 0 1,0 0.01,0 z"
        android:fillColor="#33000000" />

    <!-- 2. حلقه بیرونی فلزی (گرادیان چرخشی) -->
    <path
        android:pathData="M100,4 a96,96 0 1,0 0.01,0 z"
        android:strokeColor="#2A2A2A"
        android:strokeWidth="1">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="sweep"
                android:startColor="#F5F5F5"
                android:centerColor="#9E9E9E"
                android:endColor="#424242" />
        </aapt:attr>
    </path>

    <!-- 3. حلقه میانی تیره (بدنه اصلی Knob) -->
    <path
        android:pathData="M100,20 a80,80 0 1,0 0.01,0 z"
        android:strokeColor="#0A0A0A"
        android:strokeWidth="2">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:gradientRadius="80"
                android:centerX="100"
                android:centerY="100"
                android:startColor="#4A4A4A"
                android:endColor="#1A1A1A" />
        </aapt:attr>
    </path>

    <!-- 4. حلقه رنگی (قرمز - نشانه برند) -->
    <path
        android:pathData="M100,40 a60,60 0 1,0 0.01,0 z"
        android:strokeColor="#7F0000"
        android:strokeWidth="2">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:gradientRadius="60"
                android:centerX="100"
                android:centerY="100"
                android:startColor="#EF5350"
                android:endColor="#B71C1C" />
        </aapt:attr>
    </path>

    <!-- 5. مرکز روشن با درخشش -->
    <path
        android:pathData="M100,70 a30,30 0 1,0 0.01,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:gradientRadius="30"
                android:centerX="100"
                android:centerY="100"
                android:startColor="#FFFFFF"
                android:centerColor="#FFCDD2"
                android:endColor="#E53935" />
        </aapt:attr>
    </path>

    <!-- 6. بازتاب/براقیت بالای Knob (gloss) -->
    <!-- در layer-list: left=30dp, top=22dp, right=60dp, bottom=130dp -->
    <!-- یعنی بیضی با مرکز (85, 46) و شعاع افقی 55 و عمودی 24 -->
    <path
        android:pathData="M30,46 A55,24 0 1,0 140,46 A55,24 0 1,0 30,46 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

    <!-- 7. نشانگر جهت چرخش (خط سفید در بالای Knob) -->
    <!-- مستطیل از (97,26) تا (103,42) با گوشه‌های گرد -->
    <path
        android:pathData="M99,26 L101,26 A2,2 0 0,1 103,28 L103,40 A2,2 0 0,1 101,42 L99,42 A2,2 0 0,1 97,40 L97,28 A2,2 0 0,1 99,26 Z"
        android:fillColor="#FFFFFF" />

</vector>