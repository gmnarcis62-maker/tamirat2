<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. سایه بیرونی زیر Knob -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33000000" />
            <size android:width="200dp" android:height="200dp" />
        </shape>
    </item>

    <!-- 2. حلقه بیرونی فلزی (با گرادیان چرخشی) -->
    <item
        android:left="4dp"
        android:top="2dp"
        android:right="4dp"
        android:bottom="6dp">
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="#F5F5F5"
                android:centerColor="#9E9E9E"
                android:endColor="#424242" />
            <stroke android:width="1dp" android:color="#2A2A2A" />
        </shape>
    </item>

    <!-- 3. حلقه میانی تیره (بدنه اصلی Knob) -->
    <item
        android:left="20dp"
        android:top="18dp"
        android:right="20dp"
        android:bottom="22dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="100"
                android:startColor="#4A4A4A"
                android:endColor="#1A1A1A" />
            <stroke android:width="2dp" android:color="#0A0A0A" />
        </shape>
    </item>

    <!-- 4. حلقه رنگی (قرمز - نشانه برند) -->
    <item
        android:left="40dp"
        android:top="38dp"
        android:right="40dp"
        android:bottom="42dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="80"
                android:startColor="#EF5350"
                android:endColor="#B71C1C" />
            <stroke android:width="2dp" android:color="#7F0000" />
        </shape>
    </item>

    <!-- 5. مرکز روشن با درخشش -->
    <item
        android:left="70dp"
        android:top="68dp"
        android:right="70dp"
        android:bottom="72dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="40"
                android:startColor="#FFFFFF"
                android:centerColor="#FFCDD2"
                android:endColor="#E53935" />
        </shape>
    </item>

    <!-- 6. بازتاب/براقیت بالای Knob (gloss) -->
    <item
        android:left="30dp"
        android:top="22dp"
        android:right="60dp"
        android:bottom="130dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- 7. نشانگر جهت چرخش (خط سفید در بالای Knob) -->
    <item
        android:left="97dp"
        android:top="26dp"
        android:right="97dp"
        android:bottom="158dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>

</layer-list>